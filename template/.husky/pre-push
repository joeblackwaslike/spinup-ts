pnpm exec biome ci .
pnpm typecheck

base=$(git rev-parse -q --verify '@{upstream}' || git rev-parse -q --verify origin/main || true)
if [ -z "$base" ] || ! git diff --quiet "$base"...HEAD -- eslint.config.mjs tsconfig.json package.json pnpm-lock.yaml; then
  pnpm exec eslint . --max-warnings=0
  exit 0
fi

# ponytail: lints changed files only; a type change can surface typed-rule errors in an
# unchanged file, which CI's full `eslint .` still catches.
files=$(git diff --name-only --diff-filter=d "$base"...HEAD -- '*.ts' '*.mts' '*.cts' '*.js' '*.mjs' '*.cjs')
if [ -n "$files" ]; then
  # shellcheck disable=SC2086
  pnpm exec eslint --max-warnings=0 --no-warn-ignored $files
fi
